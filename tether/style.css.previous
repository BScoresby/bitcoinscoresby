:root { color-scheme:dark; --bg:#090a0c; --fg:#dedede; --muted:#979797; --gold:#e2b84e; --rule:#343434; }
* { box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  margin: 0;
  background: #000;
  color: #f5f5f5;
  font: 400 16px/1.8 'Space Mono', 'Courier New', monospace;
}

main { max-width:960px; margin:auto; padding:2rem 1.5rem 6rem; }
.site-header { max-width:960px; margin:0 auto; padding:1.5rem 1.5rem 0; }
.site-header, .document-title, .contents, .document h1, .document h2, .document h3, .outline-number, footer { font-family:'Space Mono', ui-monospace, SFMono-Regular, Consolas, monospace; }
a { color:var(--gold); text-decoration:underline; text-underline-offset:3px; overflow-wrap:anywhere; }
a:hover { color:#ffe09a; }
a:focus-visible { outline:2px solid var(--gold); outline-offset:3px; }
.document-title { font-size:clamp(1.6rem, 4vw, 2.7rem); line-height:1.2; margin:3rem 0; }
.contents { border-block:1px solid var(--rule); margin:2rem 0 5rem; padding:1.6rem 0; }
.contents h2 { color:var(--muted); font-size:.85rem; letter-spacing:.08em; }
.contents ol { list-style:none; padding:0; margin:1.2rem 0 0; columns:2; column-gap:2rem; }
.contents li { break-inside:avoid; font-size:.85rem; margin-bottom:.6rem; line-height:1.6; }
.contents li a { color:var(--fg); text-decoration:none; }
.contents li a:hover { color:var(--gold); text-decoration:underline; }
.contents li span { color:var(--gold); margin-right:.5rem; }
.document h1, .document h2 { font-size:clamp(1.3rem,3vw,2rem); line-height:1.35; color:#f8f8f8; border-top:1px solid var(--rule); padding-top:2rem; margin:5rem 0 2rem; scroll-margin-top:2rem; }
.document h3 { font-size:1.12rem; margin-top:2.5rem; }
.document p { margin:0 0 1.2rem; }
.document img { max-width:100%; height:auto; }
.document pre { overflow-x:auto; padding:1rem; background:#171717; }
.document code { overflow-wrap:anywhere; }
.document blockquote { color:#bdbdbd; border-left:3px solid var(--rule); margin:1.5rem 0; padding-left:1.25rem; }
.document table { display:block; overflow-x:auto; border-collapse:collapse; max-width:100%; }
.document th, .document td { padding:.5rem .8rem; border:1px solid var(--rule); }
.outline-entry { display:grid; grid-template-columns:6rem minmax(0,1fr); gap:1.25rem; margin:0 0 2rem; scroll-margin-top:1.5rem; border-left:2px solid transparent; }
.outline-number {
  font-size: 1rem;
  line-height: 1.8;
  text-decoration: none;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.outline-number:hover { text-decoration:underline; }
.outline-text { min-width:0; overflow-wrap:anywhere; }
.outline-text > :last-child { margin-bottom:0; }
.outline-entry:target { background:#272315; border-left-color:var(--gold); padding:.5rem .5rem .5rem .75rem; margin-left:-.75rem; }
footer { border-top:1px solid var(--rule); margin-top:5rem; padding-top:2rem; font-size:.8rem; }
@media(max-width:650px) { body { font-size:17px; line-height:1.7; } main { padding:1.5rem 1.1rem 4rem; } .contents ol { columns:1; } .outline-entry { display:block; margin-bottom:2.25rem; } .outline-number { display:block; margin-bottom:.35rem; } .document h1,.document h2 { margin-top:3.5rem; } }
@media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
/* =========================================
   BitcoinScoresby site integration
   ========================================= */

/* Consistent site colors and typography */
.tether-page {
  --bg: #000;
  --fg: #f5f5f5;
  --muted: #aaa;
  --rule: #555;

  background: var(--bg);
  color: var(--fg);

  font-family: 'Space Mono', 'Courier New', monospace;
  font-size: 16px;
  line-height: 1.8;
}

/* Main document width */
.tether-page .page {
  width: min(calc(100% - 44px), 960px);
  max-width: none;
  margin: 0 auto;
  padding: 42px 0 90px;
}

/* Match the site's actual shared header */
.tether-page .site-header {
  max-width: none;
  margin: 0 0 clamp(65px, 9vw, 100px);
  padding: 0 0 1rem;
  font-family: inherit;
}

/* Text and identifiers share one font */
.tether-page .document,
.tether-page .outline-number,
.tether-page .outline-text {
  font-family: inherit;
  font-size: 1rem;
  line-height: 1.8;
}

/* Keep the identifiers distinct without shrinking them */
.tether-page .outline-number {
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

/* Document title */
.tether-page .document-title {
  font-family: inherit;
  font-size: clamp(1.7rem, 4vw, 2.5rem);
  line-height: 1.3;
  letter-spacing: -0.03em;
  margin: 0 0 3rem;
}

/* Chapter headings */
.tether-page .document h2 {
  font-family: inherit;
  font-size: clamp(1.3rem, 3vw, 1.8rem);
}

/* Mobile layout */
@media (max-width: 650px) {
  .tether-page {
    font-size: 16px;
    line-height: 1.75;
  }

  .tether-page .page {
    width: calc(100% - 36px);
    padding: 25px 0 65px;
  }

  .tether-page .outline-entry {
    display: block;
    margin-bottom: 2.25rem;
  }

  .tether-page .outline-number {
    display: block;
    margin-bottom: 0.35rem;
  }
}
